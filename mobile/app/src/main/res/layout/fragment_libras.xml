<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Desenho dos landmarks: fica colado na preview (mesmas bordas) para o
        traco cair exatamente sobre a mao/corpo mostrados na camera.
    -->
    <com.visuall.app.ui.LandmarkOverlayView
        android:id="@+id/landmark_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <View
        android:id="@+id/grad_top"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/vf_grad_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/grad_bottom"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@drawable/vf_grad_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_exit_libras"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/vf_bg_action_btn"
        android:elevation="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&lt;"
        android:textColor="@color/gold_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Voltar para camera normal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        LINHAS entra no topo (no lugar do antigo "AO VIVO"): e um controle
        de exibicao, mais proximo dos ajustes do que das acoes da conversa.
    -->
    <TextView
        android:id="@+id/btn_lines"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/vf_bg_mode_inactive"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:text="LINHAS: ON"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintStart_toEndOf="@id/btn_exit_libras" />

    <!--
        Rotulo de estado, nao botao: sem fundo nem borda, so texto sobre a
        camera, para nao sugerir que e clicavel.
    -->
    <TextView
        android:id="@+id/tv_mode_label"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="150dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Modo Libras"
        android:textColor="@color/gold_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        app:layout_constraintTop_toTopOf="@id/btn_lines"
        app:layout_constraintBottom_toBottomOf="@id/btn_lines"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btn_history"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Historico"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_history"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.visuall.app.ui.ScanFrameView
        android:id="@+id/scan_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/feedback_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/chip_result"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingHorizontal="22dp"
        android:text="-   0% conf."
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/progress_confidence"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_confidence"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="168dp"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/gold_primary"
        android:progressBackgroundTint="#33242424"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/scan_frame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Feedback, REPETIR e apagar ficam na MESMA linha: os tres falam da
        letra que acabou de ser lida, entao ler e agir acontece sem o olho
        pular de uma ponta a outra da tela.
    -->
    <LinearLayout
        android:id="@+id/feedback_row"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/reply_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_feedback"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_chip"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:minWidth="154dp"
            android:paddingHorizontal="16dp"
            android:text="CENTRALIZE A MAO"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/btn_confirm_letter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="REPETIR"
            android:textColor="@color/text_on_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Repetir letra bloqueada" />

        <ImageView
            android:id="@+id/btn_delete_letter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar ultima letra"
            android:padding="10dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/reply_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vf_bg_reply_text"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/phrase_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_reply_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Resposta por voz ou texto"
            android:src="@drawable/ic_voice_reply"
            app:tint="@color/gold_primary" />

        <TextView
            android:id="@+id/tv_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="54dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/btn_reply_clear"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar resposta"
            android:padding="7dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/gold_primary" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/phrase_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_phrase"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_phrase_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Texto reconhecido em Libras"
            android:src="@drawable/ic_hands"
            app:tint="@color/gold_primary" />

        <TextView
            android:id="@+id/tv_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_clear"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/feedback_alerta"
        android:progressBackgroundTint="#33FF6060"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chip_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/reply_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_reply_panel"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/vf_bg_reply_input"
            android:hint="Digite ou grave sua resposta"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_reply_audio"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="AUDIO"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_text"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="DIGITAR"
                android:textColor="@color/text_on_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_speak"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="FALAR"
                android:textColor="@color/text_on_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_close"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.75"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="OK"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>


    <!--
        ALFABETO e CORPO ficam num container ancorado ao centro da tela, para
        que o par fique exatamente centralizado independentemente da largura
        do RESPONDER (esquerda) e do giro de camera (direita) — se estivessem
        todos numa mesma linha com peso, o par sairia deslocado.
    -->
    <LinearLayout
        android:id="@+id/modes_row"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginBottom="52dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_mode_alphabet"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="ALFABETO"
            android:textColor="@color/text_on_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="13sp" />

        <TextView
            android:id="@+id/btn_mode_body"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/vf_bg_mode_disabled"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="CORPO"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="13sp" />
    </LinearLayout>

    <!-- Acao secundaria: ocupa o espaco livre a esquerda do par central -->
    <TextView
        android:id="@+id/btn_reply"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/vf_bg_mode_inactive"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:text="RESPONDER"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="10sp"
        android:contentDescription="Falar e escrever resposta na tela"
        app:layout_constraintTop_toTopOf="@id/modes_row"
        app:layout_constraintBottom_toBottomOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/modes_row" />

    <ImageView
        android:id="@+id/btn_flip"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Girar camera"
        android:padding="10dp"
        android:src="@drawable/ic_flip"
        app:layout_constraintTop_toTopOf="@id/modes_row"
        app:layout_constraintBottom_toBottomOf="@id/modes_row"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
