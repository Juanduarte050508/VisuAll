<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        A imagem que chega dos oculos por Wi-Fi. Ocupa exatamente o mesmo lugar
        da preview e so uma das duas fica visivel por vez: assim o desenho dos
        landmarks, que se prende as bordas da preview, cai certo nas duas
        fontes sem nenhum ajuste.
    -->
    <ImageView
        android:id="@+id/iv_oculos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:contentDescription="Imagem dos oculos"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <!--
        Desenho dos landmarks: fica colado na preview (mesmas bordas) para o
        traco cair exatamente sobre a mao/corpo mostrados na camera.
    -->
    <com.visuall.app.ui.LandmarkOverlayView
        android:id="@+id/landmark_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <View
        android:id="@+id/grad_top"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/vf_grad_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/grad_bottom"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@drawable/vf_grad_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_exit_libras"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/vf_bg_action_btn"
        android:elevation="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&lt;"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Voltar para camera normal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        LINHAS entra no topo (no lugar do antigo "AO VIVO"): e um controle
        de exibicao, mais proximo dos ajustes do que das acoes da conversa.
    -->
    <TextView
        android:id="@+id/btn_lines"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/vf_bg_mode_inactive"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:text="LINHAS: ON"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintStart_toEndOf="@id/btn_exit_libras" />

    <!--
        Rotulo de estado, nao botao: sem fundo nem borda, so texto sobre a
        camera, para nao sugerir que e clicavel.
    -->
    <TextView
        android:id="@+id/tv_mode_label"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Modo Libras"
        android:textColor="@color/gold_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        app:layout_constraintTop_toTopOf="@id/btn_lines"
        app:layout_constraintBottom_toBottomOf="@id/btn_lines"
        app:layout_constraintStart_toEndOf="@id/btn_lines"
        app:layout_constraintEnd_toStartOf="@id/btn_history" />

    <ImageView
        android:id="@+id/btn_history"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Historico"
        android:elevation="8dp"
        android:padding="13dp"
        android:src="@drawable/ic_history"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.visuall.app.ui.ScanFrameView
        android:id="@+id/scan_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="104dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/feedback_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/chip_result"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingHorizontal="22dp"
        android:text="-   0% conf."
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/progress_confidence"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_confidence"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="168dp"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/gold_primary"
        android:progressBackgroundTint="#33242424"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/scan_frame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Feedback, REPETIR e apagar ficam na MESMA linha: os tres falam da
        letra que acabou de ser lida, entao ler e agir acontece sem o olho
        pular de uma ponta a outra da tela.
    -->
    <LinearLayout
        android:id="@+id/feedback_row"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/phrase_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_feedback"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_chip"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:minWidth="154dp"
            android:paddingHorizontal="16dp"
            android:text="CENTRALIZE A MAO"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/btn_confirm_letter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="REPETIR"
            android:textColor="@color/text_on_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Repetir letra bloqueada" />

        <ImageView
            android:id="@+id/btn_delete_letter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar ultima letra"
            android:padding="13dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/phrase_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_phrase"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_phrase_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Texto reconhecido em Libras"
            android:src="@drawable/ic_hands"
            app:tint="@color/gold_primary" />

        <TextView
            android:id="@+id/tv_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_clear"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/feedback_alerta"
        android:progressBackgroundTint="#33FF6060"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chip_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Modo resposta em tela cheia.

        Era uma caixa flutuante ancorada acima do modes_row, e ela cobria a
        moldura vermelha de deteccao no meio da tela: quem responde perdia de
        vista o retorno de que o app esta enxergando a mao. O texto tambem tinha
        15sp em tres linhas, pequeno demais pra ser lido do outro lado de um
        balcao.

        Em tela cheia os dois problemas somem por construcao. Nao ha o que
        cobrir, porque a camera nao esta em jogo enquanto se responde: quem
        sinaliza nao esta sinalizando nesse momento. E o texto ocupa a tela
        inteira, que e o ponto do modo — escrever, virar o celular, a pessoa
        ler de longe.

        O elevation alto e necessario porque este bloco e declarado ANTES do
        modes_row e do btn_reply; sem ele os dois seriam desenhados por cima.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reply_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_reply_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="56dp"
            android:letterSpacing="0.12"
            android:text="RESPOSTA"
            android:textColor="@color/gold_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btn_reply_exit" />

        <!--
            Historico das RESPOSTAS, so delas. O botao do modo de leitura abre o
            historico do que foi sinalizado; este abre o do que foi respondido.
            Sao consultados em momentos diferentes, entao cada um vive na tela
            onde faz sentido.
        -->
        <ImageView
            android:id="@+id/btn_reply_history"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Historico das respostas"
            android:padding="13dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_primary"
            app:layout_constraintEnd_toStartOf="@id/btn_reply_exit"
            app:layout_constraintTop_toTopOf="@id/btn_reply_exit"
            app:layout_constraintBottom_toBottomOf="@id/btn_reply_exit" />

        <ImageView
            android:id="@+id/btn_reply_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="46dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Voltar para a camera"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            O campo E a area de exibicao: o mesmo texto que se digita e o que a
            pessoa surda le. Sem isso seriam duas telas (compor e mostrar) pra
            um texto so, e alguem teria que lembrar de trocar entre elas.
        -->
        <EditText
            android:id="@+id/et_reply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@null"
            android:gravity="center"
            android:hint="Toque para escrever, ou use FALAR"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_reply_exit"
            app:layout_constraintBottom_toTopOf="@id/reply_actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/reply_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btn_reply_audio"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.5"
                android:background="@drawable/vf_bg_reply_hero"
                android:contentDescription="Falar a resposta pelo microfone"
                android:drawableStart="@drawable/ic_mic"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_on_gold"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="FALAR"
                android:textColor="@color/text_on_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_erase"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_reply_ghost"
                android:contentDescription="Apagar a resposta"
                android:gravity="center"
                android:text="LIMPAR"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_close"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/vf_bg_reply_ghost"
                android:contentDescription="Guardar e esconder o teclado para mostrar a resposta"
                android:gravity="center"
                android:text="PRONTO"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>



    <!--
        ALFABETO e CORPO ficam num container ancorado ao centro da tela, para
        que o par fique exatamente centralizado independentemente da largura
        do RESPONDER (esquerda) e do giro de camera (direita) — se estivessem
        todos numa mesma linha com peso, o par sairia deslocado.
    -->
    <LinearLayout
        android:id="@+id/modes_row"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginBottom="52dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_mode_alphabet"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="ALFABETO"
            android:textColor="@color/text_on_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="13sp" />

        <TextView
            android:id="@+id/btn_mode_body"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/vf_bg_mode_disabled"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="CORPO"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="13sp" />
    </LinearLayout>

    <!--
        Acao principal do ouvinte, espelhando o btn_flip do outro lado.

        Era um TextView com "RESPONDER" escrito, constrangido entre a borda da
        tela e o modes_row — que ocupa 234dp centrados, deixando ~43dp de
        largura aqui. A palavra nunca teve espaco: por isso o autoSize caia pra
        7sp, ilegivel. Como icone, o alvo passa a ter 48dp (o minimo tocavel
        acessivel, contra os 40dp de antes) e o rotulo vive no tooltip e no
        contentDescription, onde da pra ler.

        O traco dourado de 2dp (vf_bg_action_primary) separa acao de modo: os
        botoes ALFABETO/CORPO usam preenchimento, e antes este dividia o mesmo
        fundo deles, parecendo um terceiro modo desligado.
    -->
    <ImageView
        android:id="@+id/btn_reply"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/vf_bg_action_primary"
        android:contentDescription="Responder: toque para escrever, segure para falar"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_voice_reply"
        android:tooltipText="Responder (segure para falar)"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/modes_row"
        app:layout_constraintBottom_toBottomOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Toque troca entre a camera do celular e a dos oculos; toque longo abre
        o endereco. O endereco fica no toque longo porque muda uma vez e a
        troca acontece toda hora.
    -->
    <ImageView
        android:id="@+id/btn_oculos"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Usar a camera dos oculos"
        android:padding="13dp"
        android:src="@drawable/ic_oculos"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/modes_row"
        app:layout_constraintBottom_toBottomOf="@id/modes_row"
        app:layout_constraintEnd_toStartOf="@id/btn_flip" />

    <ImageView
        android:id="@+id/btn_flip"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Girar camera"
        android:padding="13dp"
        android:src="@drawable/ic_flip"
        app:layout_constraintTop_toTopOf="@id/modes_row"
        app:layout_constraintBottom_toBottomOf="@id/modes_row"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
