<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!--
        PreviewView com proporção dinâmica (4:3 ou 16:9, calculada em
        CameraFragment a partir da resolução real da câmera).
        Fica centralizada na faixa entre a barra de ícones do topo e a
        fileira de modos (RETRATO/FOTO/VIDEO), em vez de flutuar do topo
        até o fim da tela — isso evita que, em 16:9, a preview invada a
        área dos controles inferiores.
    -->

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="72dp"
        android:layout_marginBottom="16dp"

        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contorno sutil delimitando a área real de captura -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_viewfinder_border"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <!-- Flash -->
    <ImageView
        android:id="@+id/btn_flash"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Flash"
        android:padding="8dp"
        android:src="@drawable/ic_flash_auto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botão Aspect Ratio (topo direito) -->
    <TextView
        android:id="@+id/btn_aspect_ratio"
        android:layout_width="43dp"
        android:layout_height="39dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_zoom"
        android:contentDescription="Aspect Ratio"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="4:3"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Timer gravação -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_live"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="● 00:00"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zoom -->
    <LinearLayout
        android:id="@+id/zoom_container"
        android:layout_width="39dp"
        android:layout_height="201dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_zoom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/preview_view">

        <TextView
            android:id="@+id/tv_zoom_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10x"
            android:textColor="@color/gold_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.visuall.app.ui.VerticalZoomSlider
            android:id="@+id/seek_zoom"
            android:layout_width="34dp"
            android:layout_height="121dp"
            android:layout_marginVertical="8dp" />

        <TextView
            android:id="@+id/tv_zoom_min"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:text="1x"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Modos -->
    <LinearLayout
        android:id="@+id/modes_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/controls_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/mode_retrato"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp" android:text="RETRATO"
            android:textColor="@color/text_dim" android:textSize="12sp"
            android:letterSpacing="0.05" android:paddingVertical="6dp" />

        <TextView android:id="@+id/mode_foto"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp" android:text="FOTO"
            android:textColor="@color/gold_primary" android:textSize="12sp"
            android:letterSpacing="0.05" android:paddingVertical="6dp" />

        <TextView android:id="@+id/mode_video"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp" android:text="VIDEO"
            android:textColor="@color/text_dim" android:textSize="12sp"
            android:letterSpacing="0.05" android:paddingVertical="6dp" />

        <ImageView android:id="@+id/btn_libras_mode"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Entrar no modo Libras"
            android:padding="8dp"
            android:src="@drawable/ic_accessibility"
            app:tint="@color/gold_primary" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_gallery"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/bg_gallery"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Galeria"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/shutter_container" />

        <FrameLayout
            android:id="@+id/shutter_container"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shutter"
                android:contentDescription="Capturar" />

        </FrameLayout>

        <ImageView
            android:id="@+id/btn_flip"
            android:layout_width="54dp"
            android:layout_height="53dp"
            android:contentDescription="Girar câmera"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/shutter_container"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>