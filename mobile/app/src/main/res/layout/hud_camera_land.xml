<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_camera_land_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btn_libras_land"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Entrar no modo Libras"
            android:padding="11dp"
            android:src="@drawable/ic_accessibility"
            app:tint="#E8A020" />

        <ImageView
            android:id="@+id/btn_flip_land"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Girar camera"
            android:padding="11dp"
            android:src="@drawable/ic_flip" />

        <TextView
            android:id="@+id/btn_aspect_ratio_land"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_zoom"
            android:gravity="center"
            android:text="4:3"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
