<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <com.visuall.app.ui.LandmarkOverlayView
        android:id="@+id/landmark_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <View
        android:id="@+id/grad_top"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/vf_grad_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/grad_bottom"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@drawable/vf_grad_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_exit_libras"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/vf_bg_action_btn"
        android:elevation="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&lt;"
        android:textColor="#E8A020"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Voltar para camera normal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_live"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/vf_bg_live"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="AO VIVO"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintStart_toEndOf="@id/btn_exit_libras" />

    <TextView
        android:id="@+id/tv_mode_label"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/vf_bg_badge_gold"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:text="Modo Libras"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tv_live"
        app:layout_constraintBottom_toBottomOf="@id/tv_live"
        app:layout_constraintStart_toEndOf="@id/tv_live"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.visuall.app.ui.ScanFrameView
        android:id="@+id/scan_frame"
        android:layout_width="430dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/chip_result"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingHorizontal="22dp"
        android:text="-   0% conf."
        android:textColor="#F5F1E8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/progress_confidence"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_confidence"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="168dp"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E8A020"
        android:progressBackgroundTint="#33242424"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_feedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="154dp"
        android:paddingHorizontal="16dp"
        android:text="CENTRALIZE A MAO"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/reply_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/reply_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vf_bg_reply_text"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/phrase_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_reply_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Resposta por voz ou texto"
            android:src="@drawable/ic_voice_reply"
            app:tint="#E8A020" />

        <TextView
            android:id="@+id/tv_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="54dp"
            android:paddingVertical="10dp"
            android:textColor="#F5F1E8"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_reply_clear"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar resposta"
            android:padding="7dp"
            android:src="@drawable/ic_delete"
            app:tint="#E8A020" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/phrase_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_phrase"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/suggestions_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_phrase_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Texto reconhecido em Libras"
            android:src="@drawable/ic_hands"
            app:tint="#E8A020" />

        <TextView
            android:id="@+id/tv_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp"
            android:textColor="#F5F1E8"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/suggestions_row"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_suggestion_1"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/vf_bg_mode_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_suggestion_2"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:background="@drawable/vf_bg_mode_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_suggestion_3"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/vf_bg_mode_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_clear"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF6060"
        android:progressBackgroundTint="#33FF6060"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chip_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/reply_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_reply_panel"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/vf_bg_reply_input"
            android:hint="Digite ou grave sua resposta"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#777777"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_reply_audio"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="AUDIO"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_text"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="DIGITAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_speak"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="FALAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_close"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.75"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="OK"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calibration_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_reply_panel"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_prev"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="&lt;"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_calibration_letter"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="E"
                android:textColor="#070707"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_next"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="&gt;"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_calibration_status"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="CALIBRACAO"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_calibration"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E8A020"
            android:progressBackgroundTint="#33242424" />

        <TextView
            android:id="@+id/tv_training_status"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="0 AMOSTRAS NO CELULAR"
            android:textColor="#8B8B8B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_training_total"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#F5C842"
            android:progressBackgroundTint="#33242424" />

        <TextView
            android:id="@+id/tv_training_dashboard"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="FORTE 0% | FRACAS: A B C"
            android:textColor="#F5F1E8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_record"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="GRAVAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_save"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="SALVAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_close"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.75"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="OK"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_calibration_export"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:text="EXPORTAR DADOS"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold"
                android:contentDescription="Exportar dados de treino" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_next_weak"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="PROXIMA FRACA"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="Ir para proxima letra com poucas amostras" />

            <TextView
                android:id="@+id/btn_calibration_reset_training"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.8"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="ZERAR"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="Zerar dados de treino" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_delete_letter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar ultima letra"
            android:padding="10dp"
            android:src="@drawable/ic_delete" />

        <TextView
            android:id="@+id/btn_calibrate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingHorizontal="10dp"
            android:text="CALIBRAR"
            android:textColor="#F5F1E8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:contentDescription="Calibrar letra" />

        <TextView
            android:id="@+id/btn_confirm_letter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="REPETIR"
            android:textColor="#070707"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Repetir letra bloqueada" />

        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="10dp"
            android:text="RESPONDER"
            android:textColor="#F5F1E8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:contentDescription="Falar e escrever resposta na tela" />

        <ImageView
            android:id="@+id/btn_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Historico"
            android:padding="10dp"
            android:src="@drawable/ic_history" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modes_row"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_mode_alphabet"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="14dp"
            android:text="ALFABETO"
            android:textColor="#070707"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_mode_body"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_disabled"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingHorizontal="14dp"
            android:text="CORPO"
            android:textColor="#8B8B8B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_lines"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="12dp"
            android:text="LINHAS: ON"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controls_row"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/btn_exit_libras">

        <ImageView
            android:id="@+id/btn_gallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="42dp"
            android:background="@drawable/bg_gallery"
            android:contentDescription="Galeria"
            android:src="@drawable/ic_gallery"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/shutter_container"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_shutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="Capturar"
                android:src="@drawable/ic_shutter" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Girar camera"
            android:padding="12dp"
            android:src="@drawable/ic_flip" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
