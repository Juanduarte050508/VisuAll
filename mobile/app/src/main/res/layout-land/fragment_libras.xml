<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ver o comentario do mesmo id no layout retrato. -->
    <ImageView
        android:id="@+id/iv_oculos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:contentDescription="Imagem dos oculos"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <com.visuall.app.ui.LandmarkOverlayView
        android:id="@+id/landmark_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <View
        android:id="@+id/grad_top"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/vf_grad_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/grad_bottom"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@drawable/vf_grad_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_exit_libras"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/vf_bg_action_btn"
        android:elevation="8dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="&lt;"
        android:textColor="#E8A020"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Voltar para camera normal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_live"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/vf_bg_live"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="AO VIVO"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btn_exit_libras"
        app:layout_constraintBottom_toBottomOf="@id/btn_exit_libras"
        app:layout_constraintStart_toEndOf="@id/btn_exit_libras" />

    <TextView
        android:id="@+id/tv_mode_label"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/vf_bg_badge_gold"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:text="Modo Libras"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tv_live"
        app:layout_constraintBottom_toBottomOf="@id/tv_live"
        app:layout_constraintStart_toEndOf="@id/tv_live"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.visuall.app.ui.ScanFrameView
        android:id="@+id/scan_frame"
        android:layout_width="430dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/chip_result"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="132dp"
        android:paddingHorizontal="22dp"
        android:text="-   0% conf."
        android:textColor="#F5F1E8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/progress_confidence"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_confidence"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="168dp"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E8A020"
        android:progressBackgroundTint="#33242424"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_feedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vf_bg_chip"
        android:gravity="center"
        android:minWidth="154dp"
        android:paddingHorizontal="16dp"
        android:text="CENTRALIZE A MAO"
        android:textColor="#F5F1E8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/phrase_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/phrase_bubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_phrase"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_phrase_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="13dp"
            android:contentDescription="Texto reconhecido em Libras"
            android:src="@drawable/ic_hands"
            app:tint="#E8A020" />

        <TextView
            android:id="@+id/tv_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="42dp"
            android:paddingStart="54dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp"
            android:textColor="#F5F1E8"
            android:textSize="15sp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_clear"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF6060"
        android:progressBackgroundTint="#33FF6060"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chip_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Modo resposta em tela cheia.

        Era uma caixa flutuante ancorada acima do modes_row, e ela cobria a
        moldura vermelha de deteccao no meio da tela: quem responde perdia de
        vista o retorno de que o app esta enxergando a mao. O texto tambem tinha
        15sp em tres linhas, pequeno demais pra ser lido do outro lado de um
        balcao.

        Em tela cheia os dois problemas somem por construcao. Nao ha o que
        cobrir, porque a camera nao esta em jogo enquanto se responde: quem
        sinaliza nao esta sinalizando nesse momento. E o texto ocupa a tela
        inteira, que e o ponto do modo — escrever, virar o celular, a pessoa
        ler de longe.

        O elevation alto e necessario porque este bloco e declarado ANTES do
        modes_row e do btn_reply; sem ele os dois seriam desenhados por cima.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reply_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_reply_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.12"
            android:text="RESPOSTA"
            android:textColor="@color/gold_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btn_reply_exit" />

        <!--
            Historico das RESPOSTAS, so delas. O botao do modo de leitura abre o
            historico do que foi sinalizado; este abre o do que foi respondido.
            Sao consultados em momentos diferentes, entao cada um vive na tela
            onde faz sentido.
        -->
        <ImageView
            android:id="@+id/btn_reply_history"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Historico das respostas"
            android:padding="13dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_primary"
            app:layout_constraintEnd_toStartOf="@id/btn_reply_exit"
            app:layout_constraintTop_toTopOf="@id/btn_reply_exit"
            app:layout_constraintBottom_toBottomOf="@id/btn_reply_exit" />

        <ImageView
            android:id="@+id/btn_reply_exit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Voltar para a camera"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            O campo E a area de exibicao: o mesmo texto que se digita e o que a
            pessoa surda le. Sem isso seriam duas telas (compor e mostrar) pra
            um texto so, e alguem teria que lembrar de trocar entre elas.
        -->
        <EditText
            android:id="@+id/et_reply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@null"
            android:gravity="center"
            android:hint="Toque para escrever, ou use FALAR"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btn_reply_exit"
            app:layout_constraintBottom_toTopOf="@id/reply_actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/reply_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btn_reply_audio"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.5"
                android:background="@drawable/vf_bg_reply_hero"
                android:contentDescription="Falar a resposta pelo microfone"
                android:drawableStart="@drawable/ic_mic"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_on_gold"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="FALAR"
                android:textColor="@color/text_on_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_erase"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_reply_ghost"
                android:contentDescription="Apagar a resposta"
                android:gravity="center"
                android:text="LIMPAR"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reply_close"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/vf_bg_reply_ghost"
                android:contentDescription="Guardar e esconder o teclado para mostrar a resposta"
                android:gravity="center"
                android:text="PRONTO"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/calibration_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/vf_bg_reply_panel"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_prev"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="&lt;"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_calibration_letter"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="E"
                android:textColor="#070707"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_next"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="&gt;"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_calibration_status"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="CALIBRACAO"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_calibration"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#E8A020"
            android:progressBackgroundTint="#33242424" />

        <TextView
            android:id="@+id/tv_training_status"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="0 AMOSTRAS NO CELULAR"
            android:textColor="#8B8B8B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_training_total"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#F5C842"
            android:progressBackgroundTint="#33242424" />

        <TextView
            android:id="@+id/tv_training_dashboard"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="FORTE 0% | FRACAS: A B C"
            android:textColor="#F5F1E8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_record"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="GRAVAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_save"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="SALVAR"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calibration_close"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.75"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="OK"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_calibration_export"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:text="EXPORTAR DADOS"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold"
                android:contentDescription="Exportar dados de treino" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calibration_next_weak"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/vf_bg_mode_active"
                android:gravity="center"
                android:text="PROXIMA FRACA"
                android:textColor="#070707"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="Ir para proxima letra com poucas amostras" />

            <TextView
                android:id="@+id/btn_calibration_reset_training"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="0.8"
                android:background="@drawable/vf_bg_mode_inactive"
                android:gravity="center"
                android:text="ZERAR"
                android:textColor="#F5F1E8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="Zerar dados de treino" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modes_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_delete_letter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Apagar ultima letra"
            android:padding="10dp"
            android:src="@drawable/ic_delete" />

        <TextView
            android:id="@+id/btn_calibrate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingHorizontal="10dp"
            android:text="CALIBRAR"
            android:textColor="#F5F1E8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:contentDescription="Calibrar letra" />

        <TextView
            android:id="@+id/btn_confirm_letter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="REPETIR"
            android:textColor="#070707"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Repetir letra bloqueada" />

        <ImageView
            android:id="@+id/btn_reply"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_primary"
            android:contentDescription="Responder: toque para escrever, segure para falar"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_voice_reply"
            android:tooltipText="Responder (segure para falar)"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Historico"
            android:padding="10dp"
            android:src="@drawable/ic_history" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modes_row"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controls_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_mode_alphabet"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_active"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="14dp"
            android:text="ALFABETO"
            android:textColor="#070707"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_mode_body"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_disabled"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingHorizontal="14dp"
            android:text="CORPO"
            android:textColor="#8B8B8B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_lines"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/vf_bg_mode_inactive"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingHorizontal="12dp"
            android:text="LINHAS: ON"
            android:textColor="#F5F1E8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
        Toque troca entre a camera do celular e a dos oculos; toque longo abre
        o endereco. Fora do controls_row porque aquele FrameLayout tem 64dp e
        ja tem o botao de girar no centro.
    -->
    <!-- Par do btn_bloquear do retrato; o app roda travado em retrato, mas o
         view binding exige a view nos dois layouts pra nao virar opcional. -->
    <ImageView
        android:id="@+id/btn_bloquear"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Escurecer a tela"
        android:padding="12dp"
        android:src="@drawable/ic_cadeado"
        android:visibility="gone"
        app:tint="@color/text_primary"
        app:layout_constraintBottom_toTopOf="@id/btn_oculos"
        app:layout_constraintStart_toStartOf="@id/btn_oculos"
        app:layout_constraintEnd_toEndOf="@id/btn_oculos" />

    <ImageView
        android:id="@+id/btn_oculos"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/vf_bg_action_btn"
        android:contentDescription="Usar a camera dos oculos"
        android:padding="12dp"
        android:src="@drawable/ic_oculos"
        app:tint="@color/text_primary"
        app:layout_constraintBottom_toTopOf="@id/controls_row"
        app:layout_constraintStart_toStartOf="@id/controls_row"
        app:layout_constraintEnd_toEndOf="@id/controls_row" />

    <FrameLayout
        android:id="@+id/controls_row"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/btn_exit_libras">

        <ImageView
            android:id="@+id/btn_gallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="42dp"
            android:background="@drawable/bg_gallery"
            android:contentDescription="Galeria"
            android:src="@drawable/ic_gallery"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/shutter_container"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_shutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="Capturar"
                android:src="@drawable/ic_shutter" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/vf_bg_action_btn"
            android:contentDescription="Girar camera"
            android:padding="12dp"
            android:src="@drawable/ic_flip" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/oculos_lock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:clickable="true"
        android:elevation="32dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_lock_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="64dp"
            android:letterSpacing="0.1"
            android:text="VISUALL OUVINDO"
            android:textColor="#5A5A5A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_lock_setas"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="4dp"
            android:contentDescription="Deslize para cima para desbloquear"
            android:src="@drawable/ic_setas_desbloquear" />

        <TextView
            android:id="@+id/tv_lock_dica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="40dp"
            android:text="deslize para desbloquear"
            android:textColor="#3D3D3D"
            android:textSize="13sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
