<?xml version="1.0" encoding="utf-8"?>
<!--
    LIMPAR e PRONTO, no rodape do modo resposta.

    Era cinza #242424 com anel dourado de 1dp em 40% de opacidade — a mesma
    receita apagada que o par ALFABETO/CORPO usava, e some do mesmo jeito.

    Agora e a pilula padrao do app (vf_bg_pilula_off): preto com anel dourado
    de 2dp, texto branco por cima. O desenho nao e repetido aqui, e referenciado
    la — assim os dois lugares nunca saem de sincronia.

    O ripple fica: sao acoes, e acao precisa responder ao dedo.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#59F5C842">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/vf_bg_pilula_off" />
</ripple>
