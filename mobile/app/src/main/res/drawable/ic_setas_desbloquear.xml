<!--
    Setas da tela travada: tres pontas empilhadas apontando pra cima, dizendo
    de onde pra onde o dedo vai.

    A opacidade cresce de cima pra baixo (0,18 / 0,32 / 0,50). O olho le isso
    como movimento subindo, e nao como tres desenhos iguais. A mais forte e a
    de baixo porque e de la que o gesto comeca.

    Cinza da mesma familia do texto (#5A5A5A), e sempre bem apagado: esta tela
    fica acesa dentro do bolso, e cada pixel aceso e bateria.

    O tamanho de fabrica e grande (130dp de largura) porque este desenho e a
    unica instrucao da tela: quem pega o celular no escuro tem que enxergar o
    gesto de relance, sem ler nada. A espessura caiu de 2,4 pra 1,5 no sistema
    de coordenadas justamente porque a escala subiu: 1,5 aqui vira 3,75dp na
    tela, mais grosso em pixel do que os 2,4dp de antes, mas mais fino em
    proporcao, que e o que impede a seta grande de virar um bloco.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="130dp"
    android:height="110dp"
    android:viewportWidth="52"
    android:viewportHeight="44">

    <!-- de cima, a mais apagada -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,17 L26,3 L47,17"
        android:strokeAlpha="0.18"
        android:strokeColor="#5A5A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.5" />

    <!-- do meio -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,29 L26,15 L47,29"
        android:strokeAlpha="0.32"
        android:strokeColor="#5A5A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.5" />

    <!-- de baixo, de onde o dedo parte -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,41 L26,27 L47,41"
        android:strokeAlpha="0.50"
        android:strokeColor="#5A5A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.5" />
</vector>
