<!--
    Icone do botao de resposta: toque escreve, segurar fala.

    Era silhueta cheia, e depois do olho ficou sendo a unica area branca
    fechada da tela do modo Libras.

    A primeira tentativa de vazar manteve o desenho antigo, cabeca de perfil
    com ondas de som, so que em traco. Nao funcionou: cabeca, ombro e duas
    curvas viram quatro riscos soltos em 24dp, e no aparelho o conjunto lia
    como uma carinha, nao como alguem falando.

    Virou balao de fala, que e uma forma fechada so e por isso sobrevive
    inteira ao contorno. Tambem diz melhor o que o botao faz: o que sai dele e
    um recado ESCRITO na tela pra outra pessoa ler, com a voz sendo apenas um
    dos jeitos de ditar. E deixa de disputar significado com o ic_mic, que ja
    e o microfone dentro do proprio painel de resposta.

    Traco 1,7 com detalhe cheio, igual a ic_olho e ic_cadeado. Os tres pontos
    sao o que impede o balao de virar so um retangulo arredondado.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- balao, com a ponta caindo pra esquerda -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.8,4 L18.2,4 A3.2,3.2 0 0 1 21.4,7.2 L21.4,13.4 A3.2,3.2 0 0 1 18.2,16.6 L9.4,16.6 L4.6,20.6 L5.4,16.6 A3.2,3.2 0 0 1 2.6,13.4 L2.6,7.2 A3.2,3.2 0 0 1 5.8,4 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- o recado -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.4,10.3 m-1.05,0 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.3 m-1.05,0 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.6,10.3 m-1.05,0 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0" />
