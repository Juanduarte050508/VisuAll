<?xml version="1.0" encoding="utf-8"?>
<!-- RESPONDER fechado: o mesmo anel dourado dos outros botoes de icone. O que
     o distingue nao e mais a espessura do traco e sim o estado preenchido
     quando o painel esta aberto (vf_bg_action_primary_on). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#59F5C842">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6111111" />
            <stroke android:width="2dp" android:color="@color/gold_light" />
        </shape>
    </item>
</ripple>
