<?xml version="1.0" encoding="utf-8"?>
<!--
    FALAR, a acao principal do modo resposta.

    Continua dourado cheio de proposito. E a mesma gramatica do par
    ALFABETO/CORPO: o preenchimento dourado marca o que se destaca, e o preto
    com anel marca as outras opcoes ao lado (vf_bg_pilula_off, em
    vf_bg_reply_ghost). Se os tres ficassem iguais, PRONTO e LIMPAR — guardar e
    apagar — ficariam indistinguiveis.

    O anel subiu de 1dp pra 2dp so pra bater com a geometria dos vizinhos: o
    dourado sobre dourado quase nao aparece, mas a espessura muda o encaixe.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#59070707">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/gold_primary" />
            <stroke android:width="2dp" android:color="@color/gold_light" />
        </shape>
    </item>
</ripple>
